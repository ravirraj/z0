# Environment
NODE_ENV=development

# Database (required)
# PostgreSQL connection string - local or hosted (e.g., Vercel Postgres, Neon, Supabase)
POSTGRES_URL=

# Authentication (required)
# Generate with: openssl rand -base64 32
# Note: In development, a default secret is used if not set
BETTER_AUTH_SECRET=

# Base URL of the app (used by Better Auth for callbacks)
# BETTER_AUTH_URL=http://localhost:3000

# Google OAuth (required for "Continue with Google")
# Create credentials at https://console.cloud.google.com/apis/credentials
# and add {BETTER_AUTH_URL}/api/auth/callback/google as an authorized redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# v0 API (optional)
# Keep empty for strict BYOK mode. Each signed-in user adds their own key in-app.
# V0_API_KEY=

# Optional: Custom v0 API URL (leave empty for default)
V0_API_URL=
